# Required — get your free key at https://openrouter.ai → Sign up → Keys → Create Key
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Optional — defaults to "cohere/north-mini-code:free" if not set
# Other good free options: "google/gemini-1.5-flash", "meta-llama/llama-3.1-8b-instruct:free"
OPENROUTER_MODEL="google/gemini-1.5-flash"

# --- FastAPI service (api/) — Milestone B ---

# Optional — query-response and chunk-embedding cache. Defaults to local Redis.
# Both cache layers fail open (compute uncached) if Redis is unreachable, so this
# is a performance optimization, not a hard requirement to run the API.
# `docker compose -f docker-compose.dev.yml up -d` starts a matching local Redis.
REDIS_URL="redis://localhost:6379"

# Optional — TTL for cached /query responses, in seconds. Default shown.
QUERY_CACHE_TTL_SECONDS="3600"

# Required for the audit log (api/audit.py) and its GET /audit/recent endpoint.
# `docker compose -f docker-compose.dev.yml up -d` starts a matching local Postgres
# with this exact user/password/db, so the default below works as-is against it.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/legal_rag"

# Required to use GET /audit/recent at all — requests must send this value in an
# X-Admin-Key header. Leave unset to disable the endpoint entirely (503).
ADMIN_KEY="choose-a-random-string-here"

# Optional — comma-separated list of origins allowed to call the API from a browser.
# Defaults to http://localhost:3000 through 3009 (covers `next dev` picking the next
# free port when 3000 is already taken by something else on the machine).
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Next.js frontend (frontend/) — set in frontend/.env.local, not here ---
# See frontend/.env.local.example for NEXT_PUBLIC_API_URL.
